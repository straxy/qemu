{ 'include': 'common.json' }

##
# @x-gpio-set:
# @id: QOM canonical path of the Allwinner GPIO device
# @port: GPIO port index
# @pin:  GPIO pin index
# @level: new line level (false=low, true=high)
##
{ 'command': 'x-gpio-set',
  'data': { 'id': 'str', 'port': 'int', 'pin': 'int', 'level': 'bool' }}

##
# @GPIO_CHANGED:
# @id: QOM canonical path of the device
# @port: GPIO port index
# @pin:  GPIO pin index
# @level: output line level (false=low, true=high)
##
{ 'event': 'GPIO_CHANGED',
  'data': { 'id': 'str', 'port': 'int', 'pin': 'int', 'level': 'bool' }}
